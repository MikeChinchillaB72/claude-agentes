{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/redes_antes_de_commit.py\"",
            "timeout": 120,
            "onFailure": "block",
            "statusMessage": "Corriendo las redes antes del commit..."
          }
        ]
      }
    ]
  }
}
