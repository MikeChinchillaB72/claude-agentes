# Copia este archivo a .env y pon tu clave de https://console.anthropic.com
# .env nunca se versiona (está en .gitignore y la red `secretos` lo bloquea).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: sustituyen claves de config/agentes.toml sin tocar el archivo.
# Déjalas comentadas para que mande la configuración (docs/CONFIGURACION.md).
# AGENTE_MODELO=
# AGENTE_LOG_NIVEL=
# AGENTES_CONFIG_DIR=
